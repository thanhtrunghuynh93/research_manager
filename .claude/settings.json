{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard_docker_volumes.py\"",
            "if": "Bash(docker *)",
            "timeout": 10,
            "statusMessage": "Checking for volume-destroying Docker commands"
          }
        ]
      }
    ]
  }
}
