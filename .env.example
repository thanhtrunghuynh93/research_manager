# Copy to infra/.env for local development. Every variable is read once by backend/app/core/config.py.
# Production values are set on the host in a root-owned infra/.env with mode 600.

RM_ENV=dev
RM_LOG_LEVEL=INFO
RM_LOG_JSON=false
RM_PUBLIC_URL=http://localhost:5173

# Postgres (dev stack)
POSTGRES_DB=rm
POSTGRES_USER=rm
POSTGRES_PASSWORD=rm-dev-password
RM_DATABASE_URL=postgresql+psycopg://rm:rm-dev-password@postgres:5432/rm

# Sessions and token signing — replace in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
RM_SECRET_KEY=dev-only-change-me

# Object storage (MinIO)
MINIO_ROOT_USER=rm-minio
MINIO_ROOT_PASSWORD=rm-minio-dev-password
RM_S3_ENDPOINT=http://minio:9000
RM_S3_BUCKET=rm-dev
RM_S3_ACCESS_KEY=rm-minio
RM_S3_SECRET_KEY=rm-minio-dev-password

# OpenAI (leave empty in dev to use the fake gateway)
RM_OPENAI_API_KEY=
RM_OPENAI_MODEL=gpt-4.1
RM_OPENAI_EMBED_MODEL=text-embedding-3-small

# GitHub App (leave empty in dev to use the fake connector)
RM_GITHUB_APP_ID=
RM_GITHUB_APP_PRIVATE_KEY_PATH=
RM_GITHUB_WEBHOOK_SECRET=

# Email (dev stack sends to mailpit; UI at http://localhost:8025)
RM_SMTP_HOST=mailpit
RM_SMTP_PORT=1025
RM_SMTP_USER=
RM_SMTP_PASSWORD=
RM_MAIL_FROM=research-management@example.edu

# Uploads
RM_UPLOAD_MAX_FILE_MB=25
