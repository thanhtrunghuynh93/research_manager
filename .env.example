# Copy to infra/.env for local development. Every RM_* variable is read once by
# backend/app/core/config.py; the rest are read by Docker Compose and the backup container.
# Production values are set on the host in a root-owned infra/.env with mode 600.
#
# Nothing here is a secret. Every value marked "replace in production" is a development default
# that exists so `make dev` works on a clean checkout, and leaving one in place on a real
# deployment is the same as having no protection at all.

# ---------------------------------------------------------------- application
RM_ENV=dev
RM_LOG_LEVEL=INFO
RM_LOG_JSON=false
# Absolute links in emails and invitation links point here. In production this is the public
# https:// origin, not localhost, or a student's invitation link will not open.
RM_PUBLIC_URL=http://localhost:5173

# ---------------------------------------------------------------- database
POSTGRES_DB=rm
POSTGRES_USER=rm
POSTGRES_PASSWORD=rm-dev-password
RM_DATABASE_URL=postgresql+psycopg://rm:rm-dev-password@postgres:5432/rm

# Sessions and token signing — replace in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every session and every unused invitation and reset link.
RM_SECRET_KEY=dev-only-change-me

# ---------------------------------------------------------------- background worker
# Concurrent jobs per worker process. The assessment pipeline is the heavy one; two worker
# processes at 4 is the shape architecture §15 assumes for the 10-minute assessment budget.
RM_WORKER_CONCURRENCY=4

# ---------------------------------------------------------------- object storage (MinIO)
# Attachments are uploaded straight to this endpoint by the browser, so it must be reachable
# from the browser as well as from the API. In production that means a public hostname.
MINIO_ROOT_USER=rm-minio
MINIO_ROOT_PASSWORD=rm-minio-dev-password
RM_S3_ENDPOINT=http://minio:9000
RM_S3_BUCKET=rm-dev
RM_S3_ACCESS_KEY=rm-minio
RM_S3_SECRET_KEY=rm-minio-dev-password

# Per-file upload limit in MB (REP-04 proposes 25). Enforced before a presigned URL is issued.
RM_UPLOAD_MAX_FILE_MB=25

# ---------------------------------------------------------------- model provider
# Leave the key empty to run on the deterministic fake gateway: assessments are still produced,
# with ratings derived from stated heuristics rather than judgement. That is a valid way to pilot
# the workflow, but it should be a decision — the API logs which gateway it installed at start-up.
RM_OPENAI_API_KEY=
RM_OPENAI_MODEL=gpt-4.1
RM_OPENAI_EMBED_MODEL=text-embedding-3-small

# Spending is capped per workspace, not here: set it once after the first deploy with
#   PUT /api/v1/admin/ai/budgets   {"monthly_usd": "50.00"}
# No budget means no limit, not a limit of zero (docs/runbooks/deploy.md).

# ---------------------------------------------------------------- repository connector
# Leave empty to run on the in-memory connector. With an App configured, mount its private key
# into the api and worker containers at the path below (infra/docker-compose.yml does this from
# RM_GITHUB_APP_PRIVATE_KEY_HOST_PATH) and record each repository's installation id as its
# credential_ref when connecting it.
RM_GITHUB_APP_ID=
RM_GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
RM_GITHUB_APP_PRIVATE_KEY_HOST_PATH=./secrets/github-app.pem
RM_GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- email (REP-08 needs this)
# The missed-deadline email is a required MVP channel, so a deployment without a working mail
# provider will accept reports and never tell anyone they are late.
# The dev stack sends to mailpit; its UI is at http://localhost:8025.
RM_SMTP_HOST=mailpit
RM_SMTP_PORT=1025
RM_SMTP_USER=
RM_SMTP_PASSWORD=
RM_MAIL_FROM=research-management@example.edu

# ---------------------------------------------------------------- compose and hosting
# Read by Docker Compose rather than by the application.
RM_DOMAIN=localhost
RM_BACKEND_IMAGE=rm-backend:local
RM_CADDY_IMAGE=rm-caddy:local

# ---------------------------------------------------------------- backup (AC-16)
# Nightly at 02:00 by default. The age recipients file holds the public keys backups are
# encrypted to; the matching private key must live somewhere the drill can reach it and nowhere
# a compromise of this host would. See docs/runbooks/backup-restore.md.
BACKUP_CRON=0 2 * * *
RM_AGE_RECIPIENTS_FILE=./backup/age-recipients.txt
RM_RCLONE_CONF=./backup/rclone.conf
# Empty means local-only backups, which satisfies nothing in the recovery target: a host that
# loses its disk loses the backups with it.
RM_OFFSITE_REMOTE=
