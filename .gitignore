# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
dist/
build/

# Node
node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
# `tsc -b` incremental state. It changes on every typecheck and describes this machine's last
# build, so tracking it makes a clean tree dirty for doing nothing.
*.tsbuildinfo

# Environment and secrets
.env
infra/.env
# Per-mode env files for scripts/run.sh; infra/.env.real holds live provider credentials.
infra/.env.*
*.pem
*.key
# Host secrets mounted into the containers. The README explaining them is kept.
infra/secrets/*
!infra/secrets/README.md
# The offsite backup credential. The tracked .example carries the shape and no secret; this one
# is what rclone actually reads, and a filled-in copy is a key to every backup this host has made.
infra/backup/rclone.conf
# The age public keys backups are encrypted to. Host-specific: a copy inherited from another
# deployment would encrypt backups to a key whose private half nobody here has, which produces
# backups that look correct and can never be restored.
infra/backup/age-recipients.txt

# Editors and OS
.vscode/
.idea/
.DS_Store

# Local data
infra/data/
*.log

# Claude Code local settings
.claude/*
# `.claude/*` rather than `.claude/`: git does not descend into an excluded directory, so a
# negation under one never matches. Everything in it stays ignored except the shared hook
# configuration. `settings.local.json` stays ignored — it is personal and
# on this host it allows Bash(*), which is why nothing refused `docker compose down -v` against
# production. The guard it wires up is only useful if it survives a fresh clone.
!.claude/settings.json
