{
	# Caddy obtains and renews TLS certificates automatically for RM_DOMAIN.
	email {$RM_ACME_EMAIL:admin@example.edu}
}

{$RM_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}

	# Prometheus scrapes over the internal network, never through here. The app also requires
	# RM_METRICS_TOKEN in prod; this is the second lock, so a misconfigured token is not the only
	# thing standing between the public internet and every workspace's queue and sync health.
	handle /api/metrics* {
		respond 404
	}

	# API and webhooks; SSE needs flushing without buffering.
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			header_up X-Request-ID {http.request.uuid}
		}
	}

	# Single-page app: static assets, then index.html fallback for client routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
