{
	# Caddy obtains and renews TLS certificates automatically for RM_DOMAIN.
	email {$RM_ACME_EMAIL:admin@example.edu}
}

{$RM_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		# connect-src carries the object store because the browser PUTs an attachment straight to
		# it and never through the API (REP-04). Without the origin listed, every upload is
		# refused by the browser before a byte leaves it.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://objects.{$RM_DOMAIN:localhost}; frame-ancestors 'none'"
		-Server
	}

	# Prometheus scrapes over the internal network, never through here. The app also requires
	# RM_METRICS_TOKEN in prod; this is the second lock, so a misconfigured token is not the only
	# thing standing between the public internet and every workspace's queue and sync health.
	handle /api/metrics* {
		respond 404
	}

	# API and webhooks; SSE needs flushing without buffering.
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			header_up X-Request-ID {http.request.uuid}
		}
	}

	# Single-page app: static assets, then index.html fallback for client routes.
	#
	# The two caching rules are not symmetrical, and the asymmetry is the point. Vite fingerprints
	# everything under /assets, so those URLs are immutable by construction and can be kept for a
	# year. index.html names them, is not fingerprinted, and is the only thing that tells a browser
	# a deploy happened — so it must be revalidated every time.
	#
	# Without this block Caddy sends neither header, and a browser falls back to heuristic caching:
	# roughly a tenth of the document's age, which for a day-old index.html is hours of serving the
	# previous release from cache without ever asking. The deploy looks like it did nothing.
	handle {
		root * /srv
		@assets path /assets/*
		@revalidate not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# no-cache stores the response and requires revalidation; the ETag makes that a 304.
		header @revalidate Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

# ---------------------------------------------------------------- object storage
#
# Attachments go from the browser to the store and back without passing through the application,
# which is what keeps a 25 MB transfer off the app process — but it means the store needs a public
# name of its own. Only the S3 API is published here, on its own subdomain.
#
# The Host is not rewritten, and neither is the path. A presigned URL is signed over both: point
# this at a path prefix, or let the proxy replace the Host with `minio:9000`, and every signature
# the application issues stops verifying.
objects.{$RM_DOMAIN:localhost} {
	# No `encode` here on purpose: these payloads are already compressed archives, and re-encoding
	# an object store's responses buys nothing and surprises S3 clients.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# An attachment is a download, never a page. The store sets this per object as well; it is
		# repeated here so that publishing the bucket cannot turn an uploaded .html into a site.
		Content-Security-Policy "default-src 'none'; sandbox"
		-Server
	}

	# The admin API, the console and the health endpoints are not reachable by a presigned URL and
	# are no part of what a browser needs. Publishing the S3 API must not publish them too.
	handle /minio/* {
		respond 404
	}

	reverse_proxy minio:9000

	log {
		output stdout
		format json
	}
}
